# 复制为 .env（与 compose.yaml 同目录），docker compose 会自动读取。

# 镜像来源与版本
WB_IMAGE_REGISTRY=ghcr.io/goupengnb
WB_VERSION=2.11.9

# 面板
WB_ADMIN_PASSWORD=改成你的强口令
WB_MANAGER_BIND=0.0.0.0
WB_MANAGER_PORT=8888
WB_SECURE_COOKIE=auto
WB_SESSION_DAYS=7
WB_SESSION_IDLE_HOURS=24
WB_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# 网络
TZ=Asia/Shanghai
# 国内拉 GitHub 资源用镜像
WB_GITHUB_MIRROR=https://gh-proxy.com/
# 面板出口代理（可选，socks5/http），留空直连
WB_HTTP_PROXY=
# 新账号默认绑定的出口线路名（需先在 config.json 的 proxies 里定义）
WB_DEFAULT_ACCOUNT_PROXY=
